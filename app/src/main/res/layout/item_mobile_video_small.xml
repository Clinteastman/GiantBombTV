<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:minHeight="148dp"
    android:layout_marginEnd="12dp"
    android:orientation="vertical"
    android:paddingBottom="4dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Thumbnail with 16:9 ratio -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.giantbomb.tv.ui.EmbeddedGlassImageView
            android:id="@+id/small_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="83dp"
            android:scaleType="centerCrop" />

        <!-- Progress bar -->
        <View
            android:id="@+id/small_progress_track"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:visibility="gone" />

        <View
            android:id="@+id/small_progress_bar"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom|start"
            android:background="@color/gb_red"
            android:visibility="gone" />

        <!-- Watched checkmark -->
        <TextView
            android:id="@+id/small_watched"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="\u2713"
            android:textColor="@color/gb_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Watchlist toggle: glyph + background set in code. Bottom-end
             matches the layout used on the larger Recent cards. -->
        <TextView
            android:id="@+id/small_watchlist_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:gravity="center"
            android:textColor="@color/gb_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Add to watchlist"
            tools:text="+" />

        <TextView
            android:id="@+id/small_premium_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:text="PREMIUM"
            android:textColor="#FFFFF4"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <TextView
        android:id="@+id/small_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/gb_white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:shadowColor="#F0000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        tools:text="Video Title" />

    <TextView
        android:id="@+id/small_show_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F2FFFFFF"
        android:textSize="12sp"
        android:shadowColor="#F0000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        tools:text="Show Name" />

</LinearLayout>
